{
  "name": "cremona-cad",
  "version": "0.9.0",
  "author": "Andrew Argraves",
  "license": "GPL-3.0-only",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:fast": "ng test --watch=false --exclude \"src/app/recipes/violin-family/panels/{fluting,long-arching,cross-arching}-panel/*.spec.ts\" --exclude \"src/app/recipes/violin-family/panels/export-panel/*.spec.ts\"",
    "test:outline": "ng test --watch=false --include \"src/app/recipes/violin-family/panels/{base-measurements,main-bouts,corners,center-bout,outer-contour,fhole-placement,fhole-contours,mould,neck,volute,scroll,scroll-widths,string-setup,dev-fingerboard,dev-graduation}-panel/*.spec.ts\" --include \"src/app/recipes/violin-family/templates/*.spec.ts\"",
    "test:arching": "ng test --watch=false --include \"src/app/recipes/violin-family/panels/{fluting,long-arching,cross-arching}-panel/*.spec.ts\"",
    "test:export": "ng test --watch=false --include \"src/app/recipes/violin-family/panels/export-panel/*.spec.ts\"",
    "test:draft-canvas": "ng test --watch=false --include \"src/app/draft-canvas/**/*.spec.ts\"",
    "test:helpers": "ng test --watch=false --include \"src/app/helpers/**/*.spec.ts\"",
    "test:violin-family": "ng test --watch=false --include \"src/app/recipes/violin-family/**/*.spec.ts\"",
    "test:stress": "ng test --watch=false -c stress --include \"src/app/recipes/violin-family/violin-family-stress.spec.ts\"",
    "test:shell": "ng test --watch=false --include \"src/app/app.spec.ts\" --include \"src/app/theme/**/*.spec.ts\" --include \"src/app/docs/**/*.spec.ts\" --include \"src/app/shared/**/*.spec.ts\" --include \"src/app/top-bar/**/*.spec.ts\" --include \"src/app/settings/**/*.spec.ts\" --include \"src/app/recipes/hello-world/**/*.spec.ts\" --include \"src/app/recipe-base/**/*.spec.ts\" --include \"src/app/recipe-toolbar/**/*.spec.ts\""
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@types/d3": "^7.4.3",
    "d3": "^7.9.0",
    "jspdf": "^4.2.1",
    "polygon-clipping": "^0.15.7",
    "rxjs": "~7.8.0",
    "svg-path-properties": "^1.3.0",
    "svg2pdf.js": "^2.7.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.4",
    "@angular/cli": "^21.0.4",
    "@angular/compiler-cli": "^21.0.0",
    "jsdom": "^27.1.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
